<?xml version="1.0" encoding="utf-8"?>
<!--
  Register Markdown Desktop under Default Programs / Default Apps so Windows
  Settings can deep-link to this app. ProgIds match the WiX/MSI associations
  generated by Tauri ("Markdown Desktop.<ext>").
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="MarkdownDesktopDefaultApps" Guid="*">
        <RegistryValue
          Root="HKMU"
          Key="Software\RegisteredApplications"
          Name="Markdown Desktop"
          Type="string"
          Value="Software\Markdown Desktop\Capabilities"
          KeyPath="yes" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities"
          Name="ApplicationName"
          Type="string"
          Value="Markdown Desktop" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities"
          Name="ApplicationDescription"
          Type="string"
          Value="A focused desktop viewer and editor for Markdown files." />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities"
          Name="ApplicationIcon"
          Type="string"
          Value="[INSTALLDIR]markdown-desktop.exe,0" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities\FileAssociations"
          Name=".md"
          Type="string"
          Value="Markdown Desktop.md" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities\FileAssociations"
          Name=".markdown"
          Type="string"
          Value="Markdown Desktop.markdown" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities\FileAssociations"
          Name=".mdown"
          Type="string"
          Value="Markdown Desktop.mdown" />
        <RegistryValue
          Root="HKMU"
          Key="Software\Markdown Desktop\Capabilities\FileAssociations"
          Name=".mkdown"
          Type="string"
          Value="Markdown Desktop.mkdown" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
