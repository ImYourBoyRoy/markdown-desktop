{
  "name": "markdown-desktop",
  "version": "1.0.0",
  "description": "A viewer-first desktop application for reading and editing Markdown files.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "build:app": "node scripts/build_app.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "purge": "node scripts/purge_build_environment.mjs",
    "purge:rebuild": "node scripts/purge_build_environment.mjs --rebuild",
    "purge:fresh": "node scripts/purge_build_environment.mjs --fresh --rebuild",
    "update:dependencies": "node scripts/purge_build_environment.mjs --locks-only",
    "accessibility:audit": "node scripts/accessibility_audit.mjs",
    "smoke:native": "node scripts/native_smoke.mjs",
    "smoke:uninstall": "node scripts/uninstall_smoke.mjs",
    "audit:updater": "node scripts/updater_config_audit.mjs",
    "verify:dependencies": "node scripts/verify_dependencies.mjs",
    "audit:dependencies": "pnpm audit --audit-level high"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@viz-js/viz": "^3.29.0",
    "dompurify": "^3.4.14",
    "katex": "^0.18.4",
    "mammoth": "^1.12.1",
    "mermaid": "^11.17.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/katex": "^0.16.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
