{
  "name": "markdown-desktop",
  "version": "1.1.2",
  "description": "A local-first cross-platform Markdown desktop reader/editor for docs, notes, and AI workflows, with synchronized rendered/source views and Mermaid diagrams.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "markdown-viewer",
    "markdown-reader",
    "markdown-desktop",
    "desktop-app",
    "cross-platform",
    "local-first",
    "visual-editor",
    "source-editor",
    "mermaid",
    "github-markdown",
    "documentation",
    "ai-workflows"
  ],
  "author": "Roy Dawson IV",
  "homepage": "https://github.com/ImYourBoyRoy/markdown-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImYourBoyRoy/markdown-desktop.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build_optional_renderers.mjs",
    "build:debug": "tauri build --debug --no-bundle",
    "build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "build:app": "node scripts/build_app.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "purge": "node scripts/purge_build_environment.mjs",
    "purge:rebuild": "node scripts/purge_build_environment.mjs --rebuild",
    "purge:fresh": "node scripts/purge_build_environment.mjs --fresh --include-app --rebuild",
    "full:upgrade": "node scripts/full_upgrade.mjs",
    "architecture:check": "node scripts/architecture_inventory.mjs --check",
    "architecture:refresh": "node scripts/architecture_inventory.mjs",
    "test:architecture": "node --test scripts/architecture_inventory.test.mjs",
    "check:toolchains": "node scripts/verify-toolchains.mjs",
    "test:upgrade": "node --test scripts/upgrade.test.mjs",
    "update:dependencies": "node scripts/purge_build_environment.mjs --locks-only",
    "accessibility:audit": "node scripts/accessibility_audit.mjs",
    "wcagate:doctor": "wcagate doctor",
    "wcagate:prepare": "wcagate prepare",
    "wcagate:audit": "wcagate run",
    "wcagate:verify": "node scripts/wcag_browser.mjs",
    "wcagate:results": "wcagate serve",
    "smoke:native": "node scripts/native_smoke.mjs",
    "smoke:visual": "node scripts/visual_acceptance.mjs",
    "smoke:block-drag": "node scripts/block_drag_browser.mjs",
    "smoke:media-privacy": "node scripts/media_privacy_browser.mjs",
    "smoke:lifecycle": "node scripts/app_lifecycle_browser.mjs",
    "smoke:selection": "node scripts/selection_acceptance.mjs",
    "audit:renderers": "node scripts/renderer_budget.mjs",
    "smoke:renderers": "node scripts/optional_renderer_smoke.mjs",
    "smoke:packaged": "node scripts/packaged_acceptance.mjs",
    "benchmark:render-commit": "node scripts/render_commit_benchmark.mjs",
    "phase0:baseline": "node scripts/phase0_baseline.mjs",
    "phase1:baseline": "node scripts/phase0_baseline.mjs",
    "phase0:selection": "pnpm exec vitest run src/lib/phase0-selection-contract.test.ts --pool=forks --maxWorkers=1",
    "oracle:github-readme": "node scripts/github_host_oracle.mjs",
    "fixtures:github-readme": "node scripts/generate_github_fixtures.mjs",
    "smoke:uninstall": "node scripts/uninstall_smoke.mjs",
    "audit:updater": "node scripts/updater_config_audit.mjs",
    "verify:dependencies": "node scripts/verify_dependencies.mjs",
    "audit:dependencies": "pnpm audit --audit-level high"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@viz-js/viz": "^3.31.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@imyourboyroy/wcagate": "github:imyourboyroy/WCAGate#30be59d61db6f1cc3c5e80701fb28a0346588ca7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
